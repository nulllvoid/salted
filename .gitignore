# Root-level tooling deps (see root package.json)
node_modules/

# Expo / React Native app (app/ has its own .gitignore too, but nested
# .gitignore files only take effect if the directory is tracked from git's
# perspective — keeping broad patterns here as a safety net)
app/node_modules/
app/.expo/
app/dist/
app/web-build/
app/expo-env.d.ts
app/*.tsbuildinfo
app/ios/
app/android/
app/e2e/artifacts/
supabase/.temp/root.crt
supabase/.temp/cli-latest

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Scraped recipe candidates (data/scraped/) — working material staged for
# human review before being hand-rewritten into data/generate_dataset.py,
# not source of truth. See scripts/scrape-recipes/README.md.
data/scraped/*
!data/scraped/.gitkeep

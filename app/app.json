{
  "expo": {
    "name": "Salted",
    "slug": "salted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/salted-icon.png",
    "scheme": "salted",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.flatmeal.salted"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5ead8",
        "foregroundImage": "./assets/salted-foreground.png",
        "monochromeImage": "./assets/salted-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flatmeal.salted"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/salted-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5ead8",
          "image": "./assets/salted-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ead5d51a-a9d6-4614-b49c-4a077117eccd"
      }
    },
    "owner": "crashiv"
  }
}
